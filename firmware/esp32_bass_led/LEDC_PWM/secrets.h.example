/*
 * secrets.h.example
 * -----------------
 * Template for private Wi-Fi credentials.
 *
 * Setup:
 *   1. Copy this file to secrets.h in the same folder
 *   2. Replace the placeholder values with your real Wi-Fi info
 *   3. Keep secrets.h private (it is gitignored)
 *
 * PowerShell example:
 *   Copy-Item secrets.h.example secrets.h
 */

#ifndef SECRETS_H
#define SECRETS_H

// Your Wi-Fi network name (SSID).
const char* WIFI_SSID = "YOUR_WIFI_NAME";

// Your Wi-Fi password.
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

#endif
